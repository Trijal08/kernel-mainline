/*
 * Display (DPU) bring-up for komodo.
 *
 * The DECON0/DPP/DPU-DMA/DSIM0 topology is defined in zumapro.dtsi; this
 * board section enables it and attaches the komodo (google,gs-km4) panel via
 * a minimal boot-handoff panel driver (google,komodo-panel).
 *
 * The bootloader initialises the DCPHY, DSIM link and panel and leaves the
 * (dual-DSC, command-mode) link streaming - that is what the simple-
 * framebuffer splash draws into. The DECON DRM stack takes over scanning its
 * own framebuffer into that running link (the DECON emits the matching
 * dual-DSC stream). Disable the simple-framebuffer (and the decon-autorefresh
 * mmio-init) before relying on the DECON output, since enabling decon0 runs
 * decon_reset() and tears the bootloader splash down.
 */
&decon0 {
	status = "okay";
};

&dpu_dma {
	status = "okay";
};

&dpp0 {
	status = "okay";
};

&dsim0 {
	status = "okay";

	panel0: panel@0 {
		compatible = "google,komodo-panel";
		reg = <0>;
		/* DDIC reset for cold power-on (unused on boot handover) */
		reset-gpios = <&gpp0 0 GPIO_ACTIVE_HIGH>;

		port {
			panel0_in: endpoint {
				remote-endpoint = <&dsim0_out>;
			};
		};
	};

	ports {
		port@1 {
			reg = <1>;
			dsim0_out: endpoint {
				remote-endpoint = <&panel0_in>;
			};
		};
	};
};

/*
 * Tensor modem (Exynos Modem 5300) on PCIe CH0 / HSI1. The AP2CP rail and
 * CP2AP wakeup lines match the vendor wiring in ../fdt.dts (gpio_ap2cp_*:
 * cp_pwr_on gpp12-2, cp_nreset_n gpp12-3, pm_wrst_n gpp8-3, cp_wrst_n
 * gpp16-3, wake_up gpp16-0, pda_active gpp16-2; cp2ap wake_up gpa5-1).
 */
&pcie_0_phy {
	status = "okay";
};

&pcie_0 {
	status = "okay";
	pinctrl-0 = <&pcie0_clkreq &pcie0_perst>;
	pinctrl-names = "default";
	reset-gpios = <&gph0 0 GPIO_ACTIVE_HIGH>;	/* PERST (gph0-0) */
	google,cp-pwr-gpios = <&gpp12 2 GPIO_ACTIVE_HIGH>;
	google,cp-nreset-gpios = <&gpp12 3 GPIO_ACTIVE_HIGH>;
	google,cp-pm-wrst-gpios = <&gpp8 3 GPIO_ACTIVE_HIGH>;
	google,cp-wrst-gpios = <&gpp16 3 GPIO_ACTIVE_HIGH>;
	google,cp-wakeup-gpios = <&gpp16 0 GPIO_ACTIVE_HIGH>;
	google,cp-pda-active-gpios = <&gpp16 2 GPIO_ACTIVE_HIGH>;
};

/ {
	reserved-memory {
		/* CP IPC + boot-image staging (../fdt.dts cp_rmem) */
		cp_rmem_reserved: cp-rmem@ea400000 {
			reg = <0x0 0xea400000 0xc00000>;
			no-map;
		};

		/* CP MSI status page (../fdt.dts cp_msi_rmem) */
		cp_msi_rmem_reserved: cp-msi-rmem@f6200000 {
			reg = <0x0 0xf6200000 0x1000>;
			no-map;
		};

		/*
		 * CP PKTPROC carveout (../fdt.dts cp_rmem_1).  The CP DMAs its
		 * downlink packet-processor descriptor/buffer rings here; the AP
		 * publishes the DL info region so MAIN can complete its runtime-IPC
		 * bring-up (without a valid DL info region the pktproc-class CP never
		 * arms its legacy FMT/RAW control rings).  CP-side aperture base is
		 * pktproc_cp_base 0x20000000.
		 */
		cp_pktproc_rmem_reserved: cp-pktproc-rmem@e8000000 {
			reg = <0x0 0xe8000000 0x2000000>;
			no-map;
		};
	};

	modem {
		compatible = "samsung,s5300-modem";
		memory-region = <&cp_rmem_reserved>, <&cp_msi_rmem_reserved>,
				<&cp_pktproc_rmem_reserved>;
		memory-region-names = "ipc", "msi", "pktproc";
		/*
		 * The unmodified vendor CP image (ntn_modem/modem.bin); the
		 * driver parses its TOC and stages the BOOT section. Keyed on
		 * the modem part (s5400), not the board - komodo and caiman
		 * ship byte-identical images.  Mirror the on-device modem
		 * partition layout under /lib/firmware/google/s5400/.
		 */
		firmware-name = "google/s5400/modem/images/default/modem.bin";
		google,pcie = <&pcie_0>;
		samsung,doorbell-addr = <0x14e60000>;
		cp2ap-wakeup-gpios = <&gpa5 1 GPIO_ACTIVE_HIGH>;
	};
};
