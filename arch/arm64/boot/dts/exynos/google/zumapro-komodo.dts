/*
 * Display (DPU) bring-up for komodo.
 *
 * DECON0/DPP0/DSIM0 come from zumapro.dtsi; this board section enables them
 * and attaches the komodo (google,gs-km4) panel.  The DSI link is driven by
 * the upstream samsung_dsim bridge (google,zumapro-mipi-dsi) with the
 * Zumapro DCPHY as a separate PHY provider, so the panel is an ordinary
 * mipi_dsi_device child of the DSI host.
 */
&sysreg_dpub {
	status = "okay";
};

&mipi_phy_dsim0 {
	status = "okay";
};

&dpp0 {
	status = "okay";
};

&decon0 {
	/* selects the km4 mode list / DSC config / link rate in the DPU driver */
	google,panel-pipeline = "km4";
	status = "okay";
};

&dsi0 {
	status = "okay";

	panel0: panel@0 {
		compatible = "google,komodo-panel";
		reg = <0>;
		/* DDIC reset for cold power-on */
		reset-gpios = <&gpp0 0 GPIO_ACTIVE_HIGH>;
		/*
		 * Panel tearing-effect: gpp0-3 muxed to EINT routes the panel's
		 * TE into the DECON's DDI0 hardware trigger, which clocks out
		 * each frame in command mode.  The mux used to be applied from
		 * the old DSIM node; with the upstream samsung_dsim host it
		 * belongs on the panel, which is what owns the TE pad.
		 */
		pinctrl-names = "default";
		pinctrl-0 = <&disp_te_pri_on>;
		te-gpios = <&gpp0 3 GPIO_ACTIVE_HIGH>;
		vddi-supply = <&reg_placeholder>;
		vci-supply = <&reg_placeholder>;
		status = "okay";

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi0_out>;
			};
		};
	};

	ports {
		port@1 {
			reg = <1>;

			dsi0_out: endpoint {
				data-lanes = <1 2 3 4>;
				remote-endpoint = <&panel_in>;
			};
		};
	};
};
