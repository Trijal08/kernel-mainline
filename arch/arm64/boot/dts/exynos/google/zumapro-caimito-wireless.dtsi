/*
 * Wireless for the boards that carry the Broadcom BCM4390 combo chip:
 * caiman, komodo, tokay and comet (tegu uses a different part).
 *
 * Copyright 2025 Trijal Saha - <trijalsaha2012@gmail.com>
 */

#include <dt-bindings/gpio/gpio.h>

/* PCIe channel 1 (HSI2) connects to the Broadcom BCM4390 Wi-Fi. */
&pcie_1_phy {
	status = "okay";
};

&pcie_1 {
	pinctrl-0 = <&pcie1_clkreq &pcie1_perst>;
	pinctrl-names = "default";
	reset-gpios = <&gph3 0 GPIO_ACTIVE_HIGH>;	/* PERST */
	wlan-reg-on-gpios = <&gph3 4 GPIO_ACTIVE_HIGH>;	/* WLAN_EN */
	/* Out-of-band wake lines for the BCM4390 endpoint: WL_HOST_WAKE is the
	 * device-to-host interrupt (the dongle has no usable in-band D2H
	 * doorbell), WL_DEV_WAKE lets the host wake the dongle from deep sleep.
	 */
	host-wake-gpios = <&gpa5 3 GPIO_ACTIVE_HIGH>;	/* WL_HOST_WAKE */
	device-wake-gpios = <&gph3 5 GPIO_ACTIVE_HIGH>;	/* WL_DEV_WAKE */
	status = "okay";
};

/*
 * Standalone platform node the Broadcom bcmdhd (dhd) driver looks up by
 * compatible string (of_find_compatible_node) to obtain the WLAN GPIOs and the
 * PCIe channel index. It is NOT the PCIe endpoint (that binds by PCI id under
 * &pcie_1). WLAN_EN is owned/driven by pci-exynos for link enumeration; dhd
 * re-requests the same pin and tolerates the request failing (it reads the pin
 * already-high and skips re-driving). Only used when the bcmdhd driver replaces
 * brcmfmac; harmless otherwise.
 */
/ {
	bcmdhd_wlan: wlan {
		compatible = "android,bcmdhd_wlan";
		wl_reg_on = <&gph3 4 GPIO_ACTIVE_HIGH>;		/* WLAN_EN (shared w/ pci-exynos) */
		wl_host_wake = <&gpa5 3 GPIO_ACTIVE_HIGH>;	/* WL_HOST_WAKE (OOB D2H) */
		ch-num = <1>;					/* PCIe HSI2 channel */
		status = "okay";
	};
};
