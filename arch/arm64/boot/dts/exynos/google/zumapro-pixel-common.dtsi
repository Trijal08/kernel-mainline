/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/regulator/samsung,s2mpg10-regulator.h>
#include <dt-bindings/usb/pd.h>
#include <dt-bindings/leds/common.h>
#include "zumapro-pinctrl.h"
#include "zumapro.dtsi"

/ {
	aliases {
		serial0 = &serial_0;
	};

	chosen {
		/* Bootloader expects bootargs specified otherwise it crashes */
		bootargs = "earlycon=exynos4210,0x10870000 splash plymouth.ignore-serial-consoles plymouth.prefer-fbcon clk_ignore_unused regulator_ignore_unused pmos_boot_uuid=054e6c2a-294c-4542-be46-56ac95c6d2d9 pmos_root_uuid=738b808b-8486-42b8-9520-0cd5fa0e4ac7 pmos_rootfsopts=defaults";
		stdout-path = &serial_0;

		/* Use display framebuffer as setup by bootloader */
		framebuffer0: framebuffer-0 {
			compatible = "simple-framebuffer";
			memory-region = <&cont_splash_mem>;
			/* format properties to be added by actual board */

			status = "disabled";
		};
	};

	memory@b80000000 {
		device_type = "memory";
		reg = <0x0b 0x80000000 0x60f83000>;
	};

	memory@b00000000 {
		device_type = "memory";
		reg = <0x0b 0x00 0x80000000>;
	};

	memory@a80000000 {
		device_type = "memory";
		reg = <0x0a 0x80000000 0x80000000>;
	};

	memory@a00000000 {
		device_type = "memory";
		reg = <0x0a 0x00 0x80000000>;
	};

	memory@980000000 {
		device_type = "memory";
		reg = <0x09 0x80000000 0x80000000>;
	};

	memory@900000000 {
		device_type = "memory";
		reg = <0x09 0x00 0x80000000>;
	};

	memory@880000000 {
		device_type = "memory";
		reg = <0x08 0x80000000 0x80000000>;
	};

	decon_autorefresh_bit: mmio-init@19470030 {
		compatible = "linux,mmio-init-helper";
		reg = <0 0x19470030 0x4>;
		value = <0x3061>;

		status = "disabled";
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&key_voldown>, <&key_volup>, <&key_power>;
		pinctrl-names = "default";

		button-vol-down {
			label = "KEY_VOLUMEDOWN";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&gpa4 1 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		button-vol-up {
			label = "KEY_VOLUMEUP";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&gpa6 2 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		button-power {
			label = "KEY_POWER";
			linux,code = <KEY_POWER>;
			gpios = <&gpa4 0 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};
	};

	reboot-mode {
		compatible = "nvmem-reboot-mode";
		nvmem-cells = <&nvmem_reboot_mode>;
		nvmem-cell-names = "reboot-mode";
		mode-bootloader = <0x800000fc>;
		mode-charge = <0x8000000a>;
		mode-dm-verity-device-corrupted = <0x80000050>;
		mode-fastboot = <0x800000fa>;
		mode-reboot-ab-update = <0x80000052>;
		mode-recovery = <0x800000ff>;
		mode-rescue = <0x800000f9>;
		mode-shutdown-thermal = <0x80000051>;
		mode-shutdown-thermal-battery = <0x80000051>;
	};

	/* TODO: Remove this once PMIC is implemented  */
	reg_placeholder: regulator-0 {
		compatible = "regulator-fixed";
		regulator-name = "placeholder_reg";
	};

	/* TODO: Remove this once S2MPG11 slave PMIC is implemented  */
	ufs_0_fixed_vcc_reg: regulator-1 {
		compatible = "regulator-fixed";
		regulator-name = "ufs-vcc";
		gpio = <&gpp0 1 GPIO_ACTIVE_HIGH>;
		regulator-boot-on;
		enable-active-high;
	};

	reserved-memory {
		cont_splash_mem: splash@fac00000 {
			/* size to be updated by actual board */
			reg = <0x0 0xfac00000 0x0>;
			no-map;

			status = "disabled";
		};
	};
};

&acpm_ipc {
	pmic-1 {
		compatible = "samsung,s2mpg14-pmic";
		interrupt-parent = <&gic>;
		interrupts = <GIC_SPI 75 IRQ_TYPE_LEVEL_HIGH 0>;
		// interrupts-extended = <&gpa0 75 IRQ_TYPE_LEVEL_HIGH>;
		gpios = <&gpa9 4 GPIO_ACTIVE_LOW>,		/* SMPL_WARN_R_L */
			<&gpa10 0 GPIO_ACTIVE_HIGH>,		/* OCP_WARN_CPUCL1_R */
			<&gpa10 1 GPIO_ACTIVE_HIGH>,		/* OCP_WARN_CPUCL2_R */
			<&gpa10 2 GPIO_ACTIVE_HIGH>,		/* SOFT_OCP_WARN_CPUCL1_R */
			<&gpa10 3 GPIO_ACTIVE_HIGH>,		/* SOFT_OCP_WARN_CPUCL2_R */
			<&gpa9 2 GPIO_ACTIVE_HIGH>,		/* OCP_WARN_TPU_R */
			<&gpa9 3 GPIO_ACTIVE_HIGH>;		/* SOFT_OCP_WARN_TPU_R */
		pinctrl-names = "default";
		pinctrl-0 = <&smpl_warn>;
		system-power-controller;
		wakeup-source;

		clocks {
			compatible = "samsung,s2mpg10-clk";
			#clock-cells = <1>;
			clock-output-names = "rtc32k_ap", "peri32k1",
					     "peri32k2";
		};

		regulators {
			m_buck7_reg: buck7m {
				/* TPU rail on zumapro */
				regulator-name = "vdd_tpu";
				regulator-min-microvolt = <450000>;
				regulator-max-microvolt = <1300000>;
				regulator-ramp-delay = <6250>;
				regulator-always-on;
			};

			m_ldo5_reg: ldo5m {
				/* 1.8V always-on rail from main PMIC */
				regulator-name = "vdd_1p8_main";
				regulator-min-microvolt = <1600000>;
				regulator-max-microvolt = <1950000>;
				regulator-always-on;
			};

			m_ldo4_reg: ldo4m {
				/* L4M_TS_AVDD: touchscreen analog 3.3V */
				regulator-name = "vdd_ts_avdd";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
			};

			m_ldo25_reg: ldo25m {
				/* L25M_TSP_DVDD: touchscreen digital 1.8V */
				regulator-name = "vdd_ts_dvdd";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};
		};

		s2mpg14_gpio: gpio {
			compatible = "samsung,s2mpg14-gpio";
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <6>;
			gpio-ranges = <&s2mpg14_pinctrl 0 0 6>;
		};

		s2mpg14_pinctrl: pinctrl {
		};
	};

	pmic-2 {
		compatible = "samsung,s2mpg15-pmic";
		interrupt-parent = <&gpa0>;
		interrupts = <1 0 0>, // OCP_WARN_GPU
			     <1 0 1>; // SOFT_OCP_WARN_GPU
		// interrupts-extended = <&gpa0 76 IRQ_TYPE_LEVEL_HIGH>;
		gpios = <&gpp17 0 GPIO_ACTIVE_HIGH>,
			<&gpp17 1 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		wakeup-source;

		regulators {
			s_buck2_reg: buck2s {
				/* GPU */
				regulator-name = "vdd_g3d";
				regulator-min-microvolt = <450000>;
				regulator-max-microvolt = <1300000>;
				regulator-ramp-delay = <6250>;
				regulator-always-on;
			};

			s_buck8_reg: buck8s {
				/* GPU */
				regulator-name = "vdd_g3d_l2";
				regulator-min-microvolt = <450000>;
				regulator-max-microvolt = <1300000>;
				regulator-ramp-delay = <6250>;
				regulator-always-on;
			};

			s_ldo1_reg: ldo1s {
				/* GPU */
				regulator-name = "vdd_g3d_m";
				regulator-min-microvolt = <700000>;
				regulator-max-microvolt = <1300000>;
				regulator-always-on;
			};

			s_ldo2_reg: ldo2s {
				/* UFS/MIPI PLL rail on zumapro */
				regulator-name = "vdd_ufs_pll";
				regulator-min-microvolt = <700000>;
				regulator-max-microvolt = <1300000>;
				regulator-always-on;
			};

			s_buck11_reg: buck11s {
				/* VDD_INT_M on zumapro */
				regulator-name = "vdd_int_m";
				regulator-min-microvolt = <450000>;
				regulator-max-microvolt = <1300000>;
				regulator-ramp-delay = <6250>;
				regulator-always-on;
			};

			s_bucka_reg: bucka {
				/* the speaker amplifiers' analog supply */
				regulator-name = "vdd_bucka";
				regulator-min-microvolt = <1700000>;
				regulator-max-microvolt = <2100000>;
				regulator-always-on;
			};

			/*
			 * GNSS rails.  The receiver has no enable GPIO -- these
			 * are its only power control, and it is held up whenever
			 * the sub-PMIC is.  Left unconstrained on purpose: the
			 * levels come from PMIC OTP and nothing should retune
			 * them, so these only pin the rails on.
			 */
			s_ldo9_reg: ldo9s {
				regulator-name = "vdd_gnss_core";
				regulator-always-on;
			};

			s_ldo10_reg: ldo10s {
				regulator-name = "vdd_gnss_rf";
				regulator-always-on;
			};

			s_ldo11_reg: ldo11s {
				regulator-name = "vdd_gnss_aux";
				regulator-always-on;
			};
		};

		s2mpg15_gpio: gpio {
			compatible = "samsung,s2mpg15-gpio";
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <10>;
			gpio-ranges = <&s2mpg15_pinctrl 0 0 10>;
		};

		s2mpg15_pinctrl: pinctrl {
		};
	};
};

&ext_24_5m {
	clock-frequency = <24576000>;
};

&ext_200m {
	clock-frequency = <200000000>;
};

&ext_26m {
	clock-frequency = <26000000>;
};

&ext_1m {
	clock-frequency = <1000000>;
};

&hsi2c_9 {
	pack_bee: m24c08@50 {
		compatible = "atmel,24c08";
		reg = <0x50>;
	};

	/*
	 * STMicroelectronics ST21NFC controller. Every zumapro phone -- caiman,
	 * komodo, tokay, comet and tegu -- carries the same part on this same
	 * bus with identical wiring, so it lives in the common file rather than
	 * per board. The bus (usi9/hsi2c_9) is already enabled below for the
	 * eUSB2 repeater; NFC is simply another client at 0x08.
	 *
	 * The in-kernel st-nci driver speaks NCI over ST's NDLC framing, so no
	 * vendor firmware path is required. IRQ_N (active-high, level-triggered
	 * read-request) and RESET_N are routed to the always-on (ALIVE) GPIO
	 * banks gpa7/gph1 so the controller can wake the AP out of suspend.
	 */
	nfc: nfc@8 {
		compatible = "st,st54l-i2c";
		reg = <0x08>;

		interrupt-parent = <&gpa7>;
		interrupts = <5 IRQ_TYPE_LEVEL_HIGH>;

		reset-gpios = <&gph1 6 GPIO_ACTIVE_HIGH>;

		/*
		 * RF reference clock: PMU clock-output pad CLKOUT1.  The
		 * driver enables it while the controller is active; without
		 * it RF discovery fails though digital NCI still works.
		 */
		clocks = <&pmu_system_controller 1>;
	};
};

&hsi2c_10 {
	status = "okay";

	eeprom: eeprom@50 {
		compatible = "atmel,24c08";
		reg = <0x50>;
	};
};

&hsi2c_4 {
	status = "okay";

	flash_led: led-controller@63 {
		compatible = "ti,lm3644";
		reg = <0x63>;
		enable-gpios = <&gpp24 1 GPIO_ACTIVE_HIGH>;

		led {
			function = LED_FUNCTION_FLASH;
			color = <LED_COLOR_ID_WHITE>;
			led-sources = <0>, <1>;
			led-max-microamp = <90000>;
			flash-max-microamp = <750000>;
			flash-max-timeout-us = <100000>;
		};
	};
};

&hsi2c_6 {
	status = "okay";
	/* TODO: add the devices once drivers exist */

	max77759tcpc: usb-typec@25 {
		compatible = "maxim,max77759-tcpci", "maxim,max33359";
		reg = <0x25>;
		interrupts-extended = <&gpa8 3 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&typec_int>;
		pinctrl-names = "default";

		/* EXT_BST_EN, consumed by the max77779 OTG regulator below */
		gpio-controller;
		#gpio-cells = <2>;

		/* VBUS sourcing (host mode) via the max77779 external boost */
		vbus-supply = <&max77779_otg>;

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "dual";
			self-powered;
			try-power-role = "sink";
			op-sink-microwatt = <2600000>;
			slow-charger-loop;
			/*
			 * max77759 operating in reverse boost mode (0xA) can
			 * source up to 1.5A while extboost can only do ~1A.
			 * Since extboost is the primary path, advertise 900mA.
			 */
			source-pdos = <PDO_FIXED(5000, 900,
						 (PDO_FIXED_SUSPEND
						  | PDO_FIXED_USB_COMM
						  | PDO_FIXED_DATA_SWAP
						  | PDO_FIXED_DUAL_ROLE))>;
			sink-pdos = <PDO_FIXED(5000, 3000,
					       (PDO_FIXED_DATA_SWAP
						| PDO_FIXED_USB_COMM
						| PDO_FIXED_HIGHER_CAP
						| PDO_FIXED_DUAL_ROLE))
				     PDO_FIXED(9000, 2200, 0)
				     PDO_PPS_APDO(5000, 11000, 3000)>;
			sink-vdos = <VDO_IDH(1, 1, IDH_PTYPE_PERIPH, 0,
					     IDH_PTYPE_DFP_HOST, 2, 0x18d1)
				     VDO_CERT(0x0)
				     VDO_PRODUCT(0x4ee1, 0x0)
				     VDO_UFP(UFP_VDO_VER1_2,
					     (DEV_USB2_CAPABLE
					      | DEV_USB3_CAPABLE),
					     UFP_RECEPTACLE, 0,
					     AMA_VCONN_NOT_REQ, 0,
					     UFP_ALTMODE_NOT_SUPP,
					     UFP_USB32_GEN1)
				     /* padding */ 0
				     VDO_DFP(DFP_VDO_VER1_1,
					     (HOST_USB2_CAPABLE
					      | HOST_USB3_CAPABLE),
					     DFP_RECEPTACLE, 0)>;
			sink-vdos-v1 = <VDO_IDH(1, 1, IDH_PTYPE_PERIPH, 0,
						0, 0, 0x18d1)
					VDO_CERT(0x0)
					VDO_PRODUCT(0x4ee1, 0x0)>;
			/*
			 * Until bootloader is updated to set those two when
			 * console is enabled, we disable PD here.
			 */
			pd-disable;
			typec-power-opmode = "default";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					usbc0_orien_sw: endpoint {
						remote-endpoint = <&usbdrd31_phy_orien_switch>;
					};
				};

				port@1 {
					reg = <1>;

					usbc0_role_sw: endpoint {
						remote-endpoint = <&usbdrd31_dwc3_role_switch>;
					};
				};
			};
		};
	};

	fuel-gauge@36 {
		compatible = "maxim,max77779fg";
		reg = <0x36>;

		pinctrl-0 = <&if_pmic_fg_int>;
		pinctrl-names = "default";
		interrupts-extended = <&gpa7 7 IRQ_TYPE_LEVEL_LOW>;

		shunt-resistor-micro-ohms = <10000>;
	};

	pmic@66 {
		compatible = "maxim,max77779";
		reg = <0x66>;

		pinctrl-0 = <&if_pmic_int>;
		pinctrl-names = "default";
		interrupts-extended = <&gpa8 0 IRQ_TYPE_LEVEL_LOW>;

		interrupt-controller;
		#interrupt-cells = <2>;

		/* OTG VBUS sourced via the TCPC's external-boost enable */
		extbst-gpios = <&max77759tcpc 0 GPIO_ACTIVE_HIGH>;

		max77779_otg: otg-regulator {
			regulator-name = "vbus";
			regulator-min-microvolt = <5000000>;
			regulator-max-microvolt = <5000000>;
		};

		gpio {
			compatible = "maxim,max77779-gpio";

			gpio-controller;
			#gpio-cells = <2>;
			/*
			 * "Human-readable name [SIGNAL_LABEL]" where the
			 * latter comes from the schematic
			 */
			gpio-line-names = "OTG boost [OTG_BOOST_EN]",
					  "max20339 IRQ [MW_OVP_INT_L]";

			interrupt-controller;
			#interrupt-cells = <2>;
		};

		nvmem-0 {
			compatible = "maxim,max77779-nvmem";

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				nvmem_reboot_mode: reboot-mode@0 {
					reg = <0x0 0x4>;
				};

				boot-reason@4 {
					reg = <0x4 0x4>;
				};

				shutdown-user-flag@8 {
					reg = <0x8 0x1>;
				};

				rsoc@a {
					reg = <0xa 0x2>;
				};
			};
		};
	};
};

&pinctrl_gpio_alive {
	pmic_int: pmic-int-pins {
		samsung,pins = "gpa8-0";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};

	// sub_pmic_int: sub-pmic-int-pins {
	// 	samsung,pins = "gpa0-7";
	// 	samsung,pin-function = <GS101_PIN_FUNC_EINT>;
	// 	samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	// };

	if_pmic_fg_int: if-pmic-fg-int-pins {
		samsung,pins = "gpa7-7";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_UP>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	smpl_warn: pmic-int-pins {
		samsung,pins = "gpa9-4";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};

	key_power: key-power-pins {
		samsung,pins = "gpa4-0";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_UP>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	key_volup: key-volup-pins {
		samsung,pins = "gpa6-2";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	key_voldown: key-voldown-pins {
		samsung,pins = "gpa4-1";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	typec_int: typec-int-pins {
		samsung,pins = "gpa8-3";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_UP>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	if_pmic_int: if-pmic-int-pins {
		samsung,pins = "gpa8-0";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_UP>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

&pinctrl_gpio_custom_alive {
	ts_irq: ts-irq {
		samsung,pins = "gpn0-0";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

&serial_0 {
	status = "okay";
};

&serial_18 {
	/*
	 * Bluetooth HCI UART.  Only RXD/TXD are wired (gpa3-2/3 are the CP-PMIC
	 * SPMI lines), but serdev unconditionally sets CRTSCTS on open, which
	 * would arm this controller's hardware auto-flow control and gate TX on
	 * an nCTS nothing drives.  Suppress AFC for this port.
	 */
	samsung,no-auto-flow-control;
	status = "okay";
};

&gpu {
	status = "okay";

	sram-supply = <&s_ldo1_reg>;
};

&ufs_0 {
	vcc-supply = <&ufs_0_fixed_vcc_reg>;
	vdd-hba-supply = <&s_ldo2_reg>;
	vccq-supply = <&s_ldo2_reg>;
	vccq2-supply = <&m_ldo5_reg>;
	vcc-max-microamp = <0>;
	vccq-max-microamp = <0>;
	vccq2-max-microamp = <0>;
	
	status = "okay";
};

&ufs_0_phy {
	status = "okay";
};

&usbdrd31 {
	vdd10-supply = <&reg_placeholder>;
	vdd33-supply = <&reg_placeholder>;

	status = "okay";
};

&usbdrd31_dwc3 {
	dr_mode = "otg";
	usb-role-switch;
	role-switch-default-mode = "peripheral";
	maximum-speed = "super-speed-plus";

	status = "okay";

	port {
		usbdrd31_dwc3_role_switch: endpoint {
			remote-endpoint = <&usbc0_role_sw>;
		};
	};
};

&usbdrd31_phy {
	orientation-switch;
	/* TODO: Update these once PMIC is implemented */
	pll-supply = <&reg_placeholder>;
	dvdd-usb20-supply = <&reg_placeholder>;
	vddh-usb20-supply = <&reg_placeholder>;
	vdd33-usb20-supply = <&reg_placeholder>;
	vdda-usbdp-supply = <&reg_placeholder>;
	vddh-usbdp-supply = <&reg_placeholder>;

	status = "okay";

	port {
		usbdrd31_phy_orien_switch: endpoint {
			remote-endpoint = <&usbc0_orien_sw>;
		};
	};
};

&usi_uart {
	samsung,clkreq-on; /* needed for UART mode */

	status = "okay";
};

&usi4 {
	samsung,mode = <USI_MODE_I2C>;
	status = "okay";
};

&usi6 {
	samsung,mode = <USI_MODE_I2C>;
	status = "okay";
};

/*
 * eUSB2 repeater bus. usi9 wraps hsi2c_9; the USI mux must be enabled and put
 * in I2C mode or the controller (and the repeater @0x3e) never probes, leaving
 * the eUSB2 PHY with no path to the connector. The eUSB2 PHY (usb_hsphy)
 * consumes this repeater via phys = <&eusb_repeater>.
 */
&usi9 {
	samsung,mode = <USI_MODE_I2C>;
	status = "okay";
};

&hsi2c_9 {
	status = "okay";

	eusb_repeater: eusb-repeater@3e {
		compatible = "samsung,eusb-repeater";
		reg = <0x3e>;
		#phy-cells = <0>;
		vdd33-supply = <&reg_placeholder>;
		/* board signal tuning, as <register value> pairs */
		samsung,tune-param = <0x50 0x0a>,
				     <0x70 0x7c>,
				     <0x71 0x3c>,
				     <0x72 0x92>,
				     <0x73 0x83>,
				     <0x77 0x00>,
				     <0x78 0x0b>,
				     <0x79 0x60>;
		status = "okay";
	};
};

// &usi8 {
// 	samsung,mode = <USI_MODE_I2C>;
// 	status = "okay";
// };

&usi10 {
	samsung,mode = <USI_MODE_I2C>;

	status = "okay";
};

&usi12 {
	status = "disabled";
};

&usi13 {
	status = "disabled";
};

&usi15 {

	status = "okay";
};

&usi17 {
&usi18 {
	samsung,clkreq-on; /* needed for UART mode */

	status = "okay";
};

&usi19 {
	status = "disabled";
};

&usi20 {
	samsung,mode = <USI_MODE_SPI>;

	status = "okay";
};

&usi21 {
	samsung,mode = <USI_MODE_SPI>;

	status = "okay";
};

&usi22 {
	samsung,mode = <USI_MODE_SPI>;

	status = "okay";
};

&usi23 {
	samsung,mode = <USI_MODE_SPI>;

	status = "okay";
};

&usi24 {
	samsung,mode = <USI_MODE_SPI>;

	status = "okay";
};

&spi_15 {
	status = "okay";
};

&spi_18 {
	status = "okay";
};

&spi_19 {
	status = "okay";
};

&spi_20 {
	status = "okay";

	/*
	 * Bus on gpp4-0/1/2 with native chip-select on gpp4-3 (spi2_cs_func,
	 * FUNC_3). No cs-gpios: TouchComm needs the native manual chip-select
	 * held across the header -> continuation reads, and s3c64xx only takes
	 * that path when the CS is not a GPIO descriptor.
	 */
	pinctrl-names = "default";
	pinctrl-0 = <&spi2_bus &spi2_cs_func>;
	num-cs = <1>;

	spitouch: touchscreen@0 {
		compatible = "syna,tcm-spi";
		status = "okay";
		spi-max-frequency = <10000000>;
		reg = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&ts_irq>;
		/* TSP_INT on gpn0-0 (direct-to-GIC EINT), active low */
		interrupts-extended = <&gpn0 0 IRQ_TYPE_LEVEL_LOW>;
		/* TSP_RESET on gpp1-1 (peric0), asserted low */
		reset-gpios = <&gpp1 1 GPIO_ACTIVE_LOW>;
		/* vdd = L25M_TSP_DVDD (1.8V), avdd = L4M_TS_AVDD (3.3V) */
		vdd-supply = <&m_ldo25_reg>;
		avdd-supply = <&m_ldo4_reg>;

		/* Native manual CS (mode 0) with a 2us setup delay, per vendor */
		controller-data {
			samsung,spi-feedback-delay = <0>;
			samsung,spi-chip-select-mode = <0>;
			cs-clock-delay = <2>;
		};
	};
};

&spi_21 {
	status = "okay";
};

&spi_22 {
	status = "okay";
};

&watchdog_cl0 {
	timeout-sec = <30>;
	status = "okay";
};
