/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/regulator/samsung,s2mpg10-regulator.h>
#include <dt-bindings/usb/pd.h>
#include <dt-bindings/leds/common.h>
#include "zumapro-pinctrl.h"
#include "zumapro.dtsi"

/ {
	aliases {
		serial0 = &serial_0;
	};

	/*
	 * Cell fitted to caiman: ATL, battery id 17. The three google,chg-*
	 * arrays are the vendor charge table under their original names, so a
	 * different cell's block can be copied across unchanged: temperature
	 * band boundaries in deci-degrees, constant-voltage tiers, and for each
	 * (band, tier) the charge current as a percentage of the pack capacity,
	 * where 0 means do not charge that tier at that temperature. Below
	 * 10 degrees that stops charging at 4.3 V, which is the protection the
	 * charger's fixed fallback limit cannot express.
	 */
	battery: battery {
		compatible = "simple-battery";

		charge-full-design-microamp-hours = <4558000>;
		constant-charge-voltage-max-microvolt = <4480000>;
		constant-charge-current-max-microamp = <5469600>;

		google,chg-cv-limits = <4200000 4300000 4350000 4480000>;
		google,chg-temp-limits = <0 100 200 420 460 480 550>;
		google,chg-cc-limits = <
			 50   30    0    0
			 70   30   30   30
			120  120  120   50
			100  100  100   50
			 50   50    0    0
			 30    0    0    0
		>;
	};

	chosen {
		/* Bootloader expects bootargs specified otherwise it crashes */
		bootargs = "earlycon=exynos4210,0x10870000 splash plymouth.ignore-serial-consoles plymouth.prefer-fbcon clk_ignore_unused pmos_boot_uuid=054e6c2a-294c-4542-be46-56ac95c6d2d9 pmos_root_uuid=738b808b-8486-42b8-9520-0cd5fa0e4ac7 pmos_rootfsopts=defaults";
		stdout-path = &serial_0;

		/* Use display framebuffer as setup by bootloader */
		framebuffer0: framebuffer-0 {
			compatible = "simple-framebuffer";
			memory-region = <&cont_splash_mem>;
			/* format properties to be added by actual board */

			status = "disabled";
		};
	};

	memory_1: memory@880000000 {
		device_type = "memory";
		reg = <0x08 0x80000000 0x80000000>;
	};

	memory_2: memory@900000000 {
		device_type = "memory";
		reg = <0x09 0x00 0x80000000>;
	};

	memory_3: memory@980000000 {
		device_type = "memory";
		reg = <0x09 0x80000000 0x80000000>;
	};

	decon_autorefresh_bit: mmio-init@19470030 {
		compatible = "linux,mmio-init-helper";
		reg = <0 0x19470030 0x4>;
		value = <0x3061>;

		status = "disabled";
	};

	gpio_keys: gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&key_voldown>, <&key_volup>, <&key_power>;
		pinctrl-names = "default";

		button-vol-down {
			label = "KEY_VOLUMEDOWN";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&gpa4 1 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		button-vol-up {
			label = "KEY_VOLUMEUP";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&gpa6 2 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		button-power {
			label = "KEY_POWER";
			linux,code = <KEY_POWER>;
			gpios = <&gpa4 0 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};
	};

	reboot-mode {
		compatible = "nvmem-reboot-mode";
		nvmem-cells = <&nvmem_reboot_mode>;
		nvmem-cell-names = "reboot-mode";
		mode-bootloader = <0x800000fc>;
		mode-charge = <0x8000000a>;
		mode-dm-verity-device-corrupted = <0x80000050>;
		mode-fastboot = <0x800000fa>;
		mode-reboot-ab-update = <0x80000052>;
		mode-recovery = <0x800000ff>;
		mode-rescue = <0x800000f9>;
		mode-shutdown-thermal = <0x80000051>;
		mode-shutdown-thermal-battery = <0x80000051>;
	};

	/* TODO: Remove this once PMIC is implemented  */
	reg_placeholder: regulator-0 {
		compatible = "regulator-fixed";
		regulator-name = "placeholder_reg";
	};

	/* TODO: Remove this once S2MPG11 slave PMIC is implemented  */
	ufs_0_fixed_vcc_reg: regulator-1 {
		compatible = "regulator-fixed";
		regulator-name = "ufs-vcc";
		gpio = <&gpp0 1 GPIO_ACTIVE_HIGH>;
		regulator-boot-on;
		/*
		 * Nothing claims this -- ufs-exynos never asks for a vcc
		 * supply -- so the disable-unused sweep will pull GPP0_1 low
		 * and cut power to the rootfs.  boot-on does not stop it;
		 * only always-on does.
		 */
		regulator-always-on;
		enable-active-high;
	};

	reserved-memory {
		cont_splash_mem: splash@fac00000 {
			/* size to be updated by actual board */
			reg = <0x0 0xfac00000 0x0>;
			no-map;

			status = "disabled";
		};
	};
};

&acpm_ipc {
	pmic-1 {
		compatible = "samsung,s2mpg14-pmic";
		/*
		 * The in-band interrupt, demultiplexed out of the shared I3C
		 * line by the VGPIO2AP controller; slave index 0 is the main
		 * PMIC.  The GIC line itself (SPI 74) belongs to that
		 * controller, not here.
		 */
		interrupt-parent = <&vgpio2ap>;
		interrupts = <0 IRQ_TYPE_LEVEL_HIGH>;
		gpios = <&gpa9 4 GPIO_ACTIVE_LOW>,		/* SMPL_WARN_R_L */
			<&gpa10 0 GPIO_ACTIVE_HIGH>,		/* OCP_WARN_CPUCL1_R */
			<&gpa10 1 GPIO_ACTIVE_HIGH>,		/* OCP_WARN_CPUCL2_R */
			<&gpa10 2 GPIO_ACTIVE_HIGH>,		/* SOFT_OCP_WARN_CPUCL1_R */
			<&gpa10 3 GPIO_ACTIVE_HIGH>,		/* SOFT_OCP_WARN_CPUCL2_R */
			<&gpa9 2 GPIO_ACTIVE_HIGH>,		/* OCP_WARN_TPU_R */
			<&gpa9 3 GPIO_ACTIVE_HIGH>;		/* SOFT_OCP_WARN_TPU_R */
		pinctrl-names = "default";
		pinctrl-0 = <&smpl_warn>;
		system-power-controller;
		wakeup-source;

		clocks {
			compatible = "samsung,s2mpg10-clk";
			#clock-cells = <1>;
			clock-output-names = "rtc32k_ap", "peri32k1",
					     "peri32k2";
		};

		regulators {
			m_buck7_reg: buck7m {
				/* TPU rail on zumapro */
				regulator-name = "vdd_tpu";
				regulator-min-microvolt = <450000>;
				regulator-max-microvolt = <1300000>;
				regulator-ramp-delay = <6250>;
			};

			m_ldo5_reg: ldo5m {
				/* 1.8V always-on rail from main PMIC */
				regulator-name = "vdd_1p8_main";
				regulator-min-microvolt = <1600000>;
				regulator-max-microvolt = <1950000>;
				regulator-always-on;
			};

			m_ldo4_reg: ldo4m {
				/* L4M_TS_AVDD: touchscreen analog 3.3V */
				regulator-name = "vdd_ts_avdd";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
			};

			m_ldo25_reg: ldo25m {
				/* L25M_TSP_DVDD: touchscreen digital 1.8V */
				regulator-name = "vdd_ts_dvdd";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};
		};

		/*
		 * The main PMIC's meter block has no thermistor engine -- that
		 * is the sub PMIC -- but describing it keeps the two symmetric
		 * and gives the power meter a node of its own.
		 */
		s2mpg14_meter: meter {
			compatible = "samsung,s2mpg14-meter";
		};

		s2mpg14_gpio: gpio {
			compatible = "samsung,s2mpg14-gpio";
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <6>;
		};
	};

	pmic-2 {
		compatible = "samsung,s2mpg15-pmic";
		/*
		 * As for the main PMIC, the in-band interrupt demultiplexed out
		 * of the shared I3C line; slave index 1 is the sub PMIC.
		 */
		interrupt-parent = <&vgpio2ap>;
		interrupts = <1 IRQ_TYPE_LEVEL_HIGH>;
		gpios = <&gpp17 0 GPIO_ACTIVE_HIGH>,
			<&gpp17 1 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		wakeup-source;

		regulators {
			s_buck1_reg: buck1s {
				/*
				 * Named for the camera, but the display needs
				 * it: letting the disable-unused sweep take it
				 * SErrors the next DECON register write in
				 * zuma_decon_enable_window().  No DPU node
				 * declares a supply, so nothing holds it up on
				 * its own.
				 */
				regulator-name = "vdd_cam";
				regulator-min-microvolt = <450000>;
				regulator-max-microvolt = <1300000>;
				regulator-ramp-delay = <6250>;
				regulator-always-on;
			};

			s_buck12_reg: buck12s {
				/* Aurora DSP. No consumer in mainline. */
				regulator-name = "vdd_aur";
				regulator-min-microvolt = <450000>;
				regulator-max-microvolt = <1300000>;
				regulator-ramp-delay = <6250>;
			};

			s_buck2_reg: buck2s {
				/* GPU */
				regulator-name = "vdd_g3d";
				regulator-min-microvolt = <450000>;
				regulator-max-microvolt = <1300000>;
				regulator-ramp-delay = <6250>;
				regulator-always-on;
			};

			s_buck8_reg: buck8s {
				/* GPU */
				regulator-name = "vdd_g3d_l2";
				regulator-min-microvolt = <450000>;
				regulator-max-microvolt = <1300000>;
				regulator-ramp-delay = <6250>;
				regulator-always-on;
			};

			s_ldo1_reg: ldo1s {
				/* GPU */
				regulator-name = "vdd_g3d_m";
				regulator-min-microvolt = <700000>;
				regulator-max-microvolt = <1300000>;
				regulator-always-on;
			};

			s_ldo2_reg: ldo2s {
				/* UFS/MIPI PLL rail on zumapro */
				regulator-name = "vdd_ufs_pll";
				regulator-min-microvolt = <700000>;
				regulator-max-microvolt = <1087500>;
				regulator-always-on;
			};

			s_buck11_reg: buck11s {
				/* VDD_INT_M on zumapro */
				regulator-name = "vdd_int_m";
				regulator-min-microvolt = <450000>;
				regulator-max-microvolt = <1300000>;
				regulator-ramp-delay = <6250>;
				regulator-always-on;
			};

			s_bucka_reg: bucka {
				/* the speaker amplifiers' analog supply */
				regulator-name = "vdd_bucka";
				regulator-min-microvolt = <1700000>;
				regulator-max-microvolt = <2100000>;
				regulator-always-on;
			};

			/*
			 * GNSS rails.  The receiver has no enable GPIO -- these
			 * are its only power control, and it is held up whenever
			 * the sub-PMIC is.  Left unconstrained on purpose: the
			 * levels come from PMIC OTP and nothing should retune
			 * them, so these only pin the rails on.
			 */
			s_ldo9_reg: ldo9s {
				regulator-name = "vdd_gnss_core";
				regulator-always-on;
			};

			s_ldo10_reg: ldo10s {
				regulator-name = "vdd_gnss_rf";
				regulator-always-on;
			};

			s_ldo11_reg: ldo11s {
				regulator-name = "vdd_gnss_aux";
				regulator-always-on;
			};

			/*
			 * The rails the AoC's physical sensors sit on.  No
			 * voltage constraints: the bootloader leaves both
			 * selectors where the AoC expects them and the driver
			 * describes these enable-only, so a constraint here
			 * would fail registration rather than set a voltage.
			 */
			s_ldo5_reg: ldo5s {
				regulator-name = "L5S_PROX";
				regulator-always-on;
			};

			s_ldo7_reg: ldo7s {
				regulator-name = "L7S_SENSORS";
				regulator-always-on;
			};

			/* Camera VDDIO (L12S_CAMIO, 1.85 V).  Enable-only, as above. */
			s_ldo12_reg: ldo12s {
				regulator-name = "L12S_CAMIO";
			};

			/* UWB rails, switched by the QM35 driver.  Enable-only, as above. */
			s_ldo16_reg: ldo16s {
				regulator-name = "L16S_UWB";
			};

			s_ldo17_reg: ldo17s {
				regulator-name = "L17S_UWB";
			};
		};

		/*
		 * The sub PMIC's meter block drives the board's eight NTC
		 * thermistors as well as the power meter. Only the channels a
		 * thermal zone names are sampled.
		 */
		s2mpg15_meter: meter {
			compatible = "samsung,s2mpg15-meter";
			#thermal-sensor-cells = <1>;
		};

		s2mpg15_gpio: gpio {
			compatible = "samsung,s2mpg15-gpio";
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <10>;
		};
	};
};

&ext_24_5m {
	clock-frequency = <24576000>;
};

&ext_200m {
	clock-frequency = <200000000>;
};

&ext_26m {
	clock-frequency = <26000000>;
};

&ext_1m {
	clock-frequency = <1000000>;
};

&hsi2c_9 {
	/* Vendor runs this bus at 950 kHz; fast mode is plenty for NCI. */
	clock-frequency = <400000>;

	pack_bee: m24c08@50 {
		compatible = "atmel,24c08";
		reg = <0x50>;
	};

	/*
	 * STMicroelectronics ST21NFC controller. Every zumapro phone -- caiman,
	 * komodo, tokay, comet and tegu -- carries the same part on this same
	 * bus with identical wiring, so it lives in the common file rather than
	 * per board. The bus (usi9/hsi2c_9) is already enabled below for the
	 * eUSB2 repeater; NFC is simply another client at 0x08.
	 *
	 * The in-kernel st-nci driver speaks NCI over ST's NDLC framing, so no
	 * vendor firmware path is required. IRQ_N (active-high, level-triggered
	 * read-request) and RESET_N are routed to the always-on (ALIVE) GPIO
	 * banks gpa7/gph1 so the controller can wake the AP out of suspend;
	 * wakeup-source makes the I2C core arm IRQ_N as the wake IRQ.
	 */
	nfc: nfc@8 {
		compatible = "st,st54l-i2c";
		reg = <0x08>;

		interrupt-parent = <&gpa7>;
		interrupts = <5 IRQ_TYPE_LEVEL_HIGH>;
		wakeup-source;

		reset-gpios = <&gph1 6 GPIO_ACTIVE_HIGH>;

		/*
		 * RF reference clock: PMU clock-output pad CLKOUT1.  The
		 * driver enables it while the controller is active; without
		 * it RF discovery fails though digital NCI still works.
		 */
		clocks = <&pmu_system_controller 1>;
	};
};

&hsi2c_10 {
	status = "okay";

	eeprom: eeprom@50 {
		compatible = "atmel,24c08";
		reg = <0x50>;
	};
};

&hsi2c_4 {
	status = "okay";

	flash_led: led-controller@63 {
		compatible = "ti,lm3644";
		reg = <0x63>;
		enable-gpios = <&gpp24 1 GPIO_ACTIVE_HIGH>;

		led {
			function = LED_FUNCTION_FLASH;
			color = <LED_COLOR_ID_WHITE>;
			led-sources = <0>, <1>;
			led-max-microamp = <90000>;
			flash-max-microamp = <750000>;
			flash-max-timeout-us = <100000>;
		};
	};
};

&hsi2c_6 {
	status = "okay";
	/* TODO: add the devices once drivers exist */

	max77759tcpc: usb-typec@25 {
		compatible = "maxim,max77759-tcpci", "maxim,max33359";
		reg = <0x25>;
		interrupts-extended = <&gpa8 3 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&typec_int>;
		pinctrl-names = "default";

		/* EXT_BST_EN, consumed by the max77779 OTG regulator below */
		gpio-controller;
		#gpio-cells = <2>;

		/*
		 * The SBU switch that routes DP AUX to the connector lives in
		 * this TCPC, so the connector links its mode switch back here.
		 */
		mode-switch;

		/* VBUS sourcing (host mode) via the max77779 external boost */
		vbus-supply = <&max77779_otg>;

		port {
			usbc0_sbu_sw_in: endpoint {
				remote-endpoint = <&usbc0_sbu_sw>;
			};
		};

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "dual";
			self-powered;
			try-power-role = "sink";
			op-sink-microwatt = <2600000>;
			slow-charger-loop;
			/*
			 * max77759 operating in reverse boost mode (0xA) can
			 * source up to 1.5A while extboost can only do ~1A.
			 * Since extboost is the primary path, advertise 900mA.
			 */
			source-pdos = <PDO_FIXED(5000, 900,
						 (PDO_FIXED_SUSPEND
						  | PDO_FIXED_USB_COMM
						  | PDO_FIXED_DATA_SWAP
						  | PDO_FIXED_DUAL_ROLE))>;
			sink-pdos = <PDO_FIXED(5000, 3000,
					       (PDO_FIXED_DATA_SWAP
						| PDO_FIXED_USB_COMM
						| PDO_FIXED_HIGHER_CAP
						| PDO_FIXED_DUAL_ROLE))
				     PDO_FIXED(9000, 2200, 0)
				     PDO_PPS_APDO(5000, 11000, 3000)>;
			sink-vdos = <VDO_IDH(1, 1, IDH_PTYPE_PERIPH, 0,
					     IDH_PTYPE_DFP_HOST, 2, 0x18d1)
				     VDO_CERT(0x0)
				     VDO_PRODUCT(0x4ee1, 0x0)
				     VDO_UFP(UFP_VDO_VER1_2,
					     (DEV_USB2_CAPABLE
					      | DEV_USB3_CAPABLE),
					     UFP_RECEPTACLE, 0,
					     AMA_VCONN_NOT_REQ, 0,
					     UFP_ALTMODE_NOT_SUPP,
					     UFP_USB32_GEN1)
				     /* padding */ 0
				     VDO_DFP(DFP_VDO_VER1_1,
					     (HOST_USB2_CAPABLE
					      | HOST_USB3_CAPABLE),
					     DFP_RECEPTACLE, 0)>;
			sink-vdos-v1 = <VDO_IDH(1, 1, IDH_PTYPE_PERIPH, 0,
						0, 0, 0x18d1)
					VDO_CERT(0x0)
					VDO_PRODUCT(0x4ee1, 0x0)>;
			typec-power-opmode = "default";

			/*
			 * Where the DP alt mode driver sends hotplug: it
			 * resolves this reference and raises an out-of-band
			 * event on the DRM connector whose fwnode matches,
			 * which drm_bridge_connector turns into an HPD notify.
			 * Undocumented in usb-connector.yaml, but it is what
			 * dp_altmode_probe() looks for.
			 */
			displayport = <&dp>;

			/*
			 * dp_altmode_probe() intersects this against the
			 * partner's pin assignments and refuses the mode if
			 * nothing overlaps, so the port has to name its own:
			 * DFP_D, HBR3, receptacle, assignments C (four DP
			 * lanes) and D (two, USB3 alongside) -- the two the
			 * combo PHY's TCA mux can route.
			 */
			altmodes {
				displayport {
					svid = /bits/ 16 <0xff01>;
					vdo = <0x00000c46>;
				};
			};

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				/*
				 * High speed: the DWC3 data role, and the
				 * TCPC's own switches.
				 */
				port@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;

					usbc0_role_sw: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&usbdrd31_dwc3_role_switch>;
					};

					usbc0_sbu_sw: endpoint@1 {
						reg = <1>;
						remote-endpoint = <&usbc0_sbu_sw_in>;
					};
				};

				/* Super speed: the USB31DRD combo PHY, which */
				/* takes the connector orientation.           */
				port@1 {
					reg = <1>;

					usbc0_orien_sw: endpoint {
						remote-endpoint = <&usbdrd31_phy_orien_switch>;
					};
				};

				/*
				 * SBU: no AUX switch is described here yet, so
				 * this port carries only the alternate mode
				 * lane routing, which the combo PHY's TCA does.
				 */
				port@2 {
					reg = <2>;

					usbc0_mode_sw: endpoint {
						remote-endpoint = <&usbdrd31_phy_mode_switch>;
					};
				};
			};
		};
	};

	fuel_gauge: fuel-gauge@36 {
		compatible = "maxim,max77779fg";
		reg = <0x36>;

		pinctrl-0 = <&if_pmic_fg_int>;
		pinctrl-names = "default";
		interrupts-extended = <&gpa7 7 IRQ_TYPE_LEVEL_LOW>;

		shunt-resistor-micro-ohms = <2000>;

		/*
		 * ATL cell, battery id 17 (the gauge's resistance_id), taken from
		 * the vendor tokay battery data -- caiman shares it. Verified
		 * word-for-word against a gauge the stock stack had loaded.
		 */
		maxim,fg-model = /bits/ 16 <
			0x9810 0xad30 0xb770 0xb8a0 0xba30 0xbde0 0xbf00 0xc030
			0xc1b0 0xc4d0 0xc7f0 0xcc70 0xcf80 0xd390 0xd6c0 0xdf10
			0x0060 0x0150 0x1640 0x0b40 0x0a50 0x2930 0x1290 0x0f80
			0x07d0 0x07b0 0x07f0 0x05b0 0x06e0 0x0790 0x05b0 0x05b0
		>;

		/* (register, value); the gauge's own Config/dPAcc/Config2 among them */
		maxim,fg-params = /bits/ 16 <
			0x00c0 0xc1b0 0x00b6 0x083b 0x009f 0x660e 0x000c 0x4207
			0x00ab 0x0081 0x00bc 0x5f00 0x00a9 0x0780 0x00b3 0x0780
			0x0046 0x0c80 0x00a5 0x0780 0x00c6 0xa55a 0x00a0 0x3584
			0x00a1 0x1e06 0x00a2 0x0804 0x00a3 0x0685 0x00a6 0x0600
			0x00a7 0x2103 0x009c 0x0247 0x00b2 0x3870 0x009e 0x0400
			0x00ca 0xc8ff 0x009d 0xcea4
		>;
	};

	pmic@66 {
		compatible = "maxim,max77779";
		reg = <0x66>;

		pinctrl-0 = <&if_pmic_int>;
		pinctrl-names = "default";
		interrupts-extended = <&gpa8 0 IRQ_TYPE_LEVEL_LOW>;

		interrupt-controller;
		#interrupt-cells = <2>;

		/* OTG VBUS sourced via the TCPC's external-boost enable */
		extbst-gpios = <&max77759tcpc 0 GPIO_ACTIVE_HIGH>;

		charger {
			compatible = "maxim,max77779-charger";

			monitored-battery = <&battery>;
			fuel-gauge = <&fuel_gauge>;
		};

		max77779_otg: otg-regulator {
			regulator-name = "vbus";
			regulator-min-microvolt = <5000000>;
			regulator-max-microvolt = <5000000>;
			/*
			 * Enabling is one write to the boost's enable; it then
			 * soft-starts on its own and nothing reports when the
			 * rail is live, so hold consumers off for as long as
			 * that takes. The vendor driver open-codes the same
			 * wait as two 5ms sleeps around the assert.
			 */
			regulator-enable-ramp-delay = <10000>;
		};

		gpio {
			compatible = "maxim,max77779-gpio";

			gpio-controller;
			#gpio-cells = <2>;
			/*
			 * "Human-readable name [SIGNAL_LABEL]" where the
			 * latter comes from the schematic
			 */
			gpio-line-names = "OTG boost [OTG_BOOST_EN]",
					  "max20339 IRQ [MW_OVP_INT_L]";

			interrupt-controller;
			#interrupt-cells = <2>;
		};

		nvmem-0 {
			compatible = "maxim,max77779-nvmem";

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				nvmem_reboot_mode: reboot-mode@0 {
					reg = <0x0 0x4>;
				};

				boot-reason@4 {
					reg = <0x4 0x4>;
				};

				shutdown-user-flag@8 {
					reg = <0x8 0x1>;
				};

				rsoc@a {
					reg = <0xa 0x2>;
				};
			};
		};
	};
};

&pinctrl_gpio_alive {
	pmic_int: pmic-int-pins {
		samsung,pins = "gpa8-0";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};

	// sub_pmic_int: sub-pmic-int-pins {
	// 	samsung,pins = "gpa0-7";
	// 	samsung,pin-function = <GS101_PIN_FUNC_EINT>;
	// 	samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	// };

	if_pmic_fg_int: if-pmic-fg-int-pins {
		samsung,pins = "gpa7-7";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_UP>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	smpl_warn: pmic-int-pins {
		samsung,pins = "gpa9-4";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};

	key_power: key-power-pins {
		samsung,pins = "gpa4-0";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_UP>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	key_volup: key-volup-pins {
		samsung,pins = "gpa6-2";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	key_voldown: key-voldown-pins {
		samsung,pins = "gpa4-1";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	typec_int: typec-int-pins {
		samsung,pins = "gpa8-3";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_UP>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	if_pmic_int: if-pmic-int-pins {
		samsung,pins = "gpa8-0";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_UP>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

&pinctrl_gpio_custom_alive {
	ts_irq: ts-irq {
		samsung,pins = "gpn0-0";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

&serial_0 {
	status = "okay";
};

&serial_18 {
	/*
	 * Bluetooth HCI UART.  Only RXD/TXD are wired (gpa3-2/3 are the CP-PMIC
	 * SPMI lines), but serdev unconditionally sets CRTSCTS on open, which
	 * would arm this controller's hardware auto-flow control and gate TX on
	 * an nCTS nothing drives.  Suppress AFC for this port.
	 */
	samsung,no-auto-flow-control;
	status = "okay";
};

&gpu {
	status = "okay";

	sram-supply = <&s_ldo1_reg>;
};

/*
 * Hardware video encode and decode, with its own CMU and that CMU's SYSREG.
 * The power domain and the SysMMU need no enabling - they carry no status and
 * are live already.
 */
&mfc {
	status = "okay";
};

&cmu_mfc {
	status = "okay";
};

&sysreg_mfc {
	status = "okay";
};

/*
 * The NoC QoS ports the codec votes memory bandwidth through.  Not codec
 * specific - any master that needs a bandwidth floor goes through here.
 */
&bts {
	status = "okay";
};

&ufs_0 {
	vcc-supply = <&ufs_0_fixed_vcc_reg>;
	vdd-hba-supply = <&s_ldo2_reg>;
	vccq-supply = <&s_ldo2_reg>;
	vccq2-supply = <&m_ldo5_reg>;
	vcc-max-microamp = <0>;
	vccq-max-microamp = <0>;
	vccq2-max-microamp = <0>;
	
	status = "okay";
};

&ufs_0_phy {
	status = "okay";
};

&usbdrd31 {
	vdd10-supply = <&reg_placeholder>;
	vdd33-supply = <&reg_placeholder>;

	status = "okay";
};

&usbdrd31_dwc3 {
	dr_mode = "otg";
	usb-role-switch;
	role-switch-default-mode = "peripheral";
	maximum-speed = "super-speed-plus";

	status = "okay";

	port {
		usbdrd31_dwc3_role_switch: endpoint {
			remote-endpoint = <&usbc0_role_sw>;
		};
	};
};

&usbdrd31_phy {
	orientation-switch;
	mode-switch;
	/* TODO: Update these once PMIC is implemented */
	pll-supply = <&reg_placeholder>;
	dvdd-usb20-supply = <&reg_placeholder>;
	vddh-usb20-supply = <&reg_placeholder>;
	vdd33-usb20-supply = <&reg_placeholder>;
	vdda-usbdp-supply = <&reg_placeholder>;
	vddh-usbdp-supply = <&reg_placeholder>;

	status = "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		usbdrd31_phy_orien_switch: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&usbc0_orien_sw>;
		};

		usbdrd31_phy_mode_switch: endpoint@1 {
			reg = <1>;
			remote-endpoint = <&usbc0_mode_sw>;
		};
	};
};

&usi_uart {
	samsung,clkreq-on; /* needed for UART mode */

	status = "okay";
};

&usi4 {
	samsung,mode = <USI_MODE_I2C>;
	status = "okay";
};

&usi6 {
	samsung,mode = <USI_MODE_I2C>;
	status = "okay";
};

/*
 * eUSB2 repeater bus. usi9 wraps hsi2c_9; the USI mux must be enabled and put
 * in I2C mode or the controller (and the repeater @0x3e) never probes, leaving
 * the eUSB2 PHY with no path to the connector. The eUSB2 PHY (usb_hsphy)
 * consumes this repeater via phys = <&eusb_repeater>.
 */
&usi9 {
	samsung,mode = <USI_MODE_I2C>;
	status = "okay";
};

&hsi2c_9 {
	status = "okay";

	eusb_repeater: eusb-repeater@3e {
		compatible = "samsung,eusb-repeater";
		reg = <0x3e>;
		#phy-cells = <0>;
		vdd33-supply = <&reg_placeholder>;
		/* board signal tuning, as <register value> pairs */
		samsung,tune-param = <0x50 0x0a>,
				     <0x70 0x7c>,
				     <0x71 0x3c>,
				     <0x72 0x92>,
				     <0x73 0x83>,
				     <0x77 0x00>,
				     <0x78 0x0b>,
				     <0x79 0x60>;
		status = "okay";
	};
};

// &usi8 {
// 	samsung,mode = <USI_MODE_I2C>;
// 	status = "okay";
// };

&usi10 {
	samsung,mode = <USI_MODE_I2C>;

	status = "okay";
};

&usi15 {
	samsung,mode = <USI_MODE_SPI>;

	status = "okay";
};

&usi17 {
	status = "disabled";
};

&usi18 {
	samsung,clkreq-on; /* needed for UART mode */

	status = "okay";
};

&usi20 {
	samsung,mode = <USI_MODE_SPI>;

	status = "okay";
};

&usi21 {
	samsung,mode = <USI_MODE_SPI>;

	status = "okay";
};

&usi22 {
	samsung,mode = <USI_MODE_SPI>;

	status = "okay";
};

&usi23 {
	samsung,mode = <USI_MODE_SPI>;

	status = "okay";
};

&usi24 {
	samsung,mode = <USI_MODE_SPI>;

	status = "okay";
};

/*
 * The ST54L's embedded secure element (it hosts the eSIM) hangs off its own
 * SPI port on usi15.  There is no in-kernel protocol for it: the secure
 * element HAL exchanges raw APDUs over spidev.  Its RESET_N (gph1-5) and
 * chip-enable (gpa0-1) lines have no runtime use from Linux and are held in
 * the running state by the hogs below.
 */
&spi_15 {
	status = "okay";
	pinctrl-0 = <&spi15_bus &spi15_cs>;
	cs-gpios = <&gpp22 3 GPIO_ACTIVE_HIGH>;

	ese: secure-element@0 {
		compatible = "st,st54spi";
		reg = <0>;
		spi-max-frequency = <8000000>;
		spi-cs-setup-delay-ns = <18000>;
	};
};

&gph1 {
	ese-reset-hog {
		gpio-hog;
		gpios = <5 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "ESE_RST_N";
	};
};

&gpa0 {
	ese-enable-hog {
		gpio-hog;
		gpios = <1 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "ESE_CHIP_EN";
	};
};

/*
 * Qorvo QM35 UWB transceiver on HSI0's USI0, whose pins are dedicated (no
 * mux, hence no pinctrl).  SS_IRQ and SS_READY sit on the ALIVE banks so the
 * chip can wake the AP.
 */
&spi_18 {
	status = "okay";

	uwb: uwb@0 {
		compatible = "qorvo,qm35";
		reg = <0>;
		spi-max-frequency = <20000000>;
		spi-cs-setup-delay-ns = <10000>;

		vdd1-supply = <&s_bucka_reg>;
		vdd2-supply = <&s_ldo16_reg>;
		vdd3-supply = <&s_bucka_reg>;
		vdd4-supply = <&s_ldo17_reg>;

		reset-gpios = <&gpp14 0 GPIO_ACTIVE_LOW>;
		exton-gpios = <&gpp13 1 GPIO_ACTIVE_HIGH>;
		ready-gpios = <&gpn4 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		irq-gpios = <&gpn5 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		wakeup-gpios = <&gpp15 1 GPIO_ACTIVE_HIGH>;
	};
};

&spi_19 {
	status = "okay";
};

&spi_20 {
	status = "okay";

	/*
	 * Bus on gpp4-0/1/2 with native chip-select on gpp4-3 (spi2_cs_func,
	 * FUNC_3). No cs-gpios: TouchComm needs the native manual chip-select
	 * held across the header -> continuation reads, and s3c64xx only takes
	 * that path when the CS is not a GPIO descriptor.
	 */
	pinctrl-names = "default";
	pinctrl-0 = <&spi2_bus &spi2_cs_func>;
	num-cs = <1>;

	spitouch: touchscreen@0 {
		compatible = "syna,tcm-spi";
		status = "okay";
		spi-max-frequency = <10000000>;
		reg = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&ts_irq>;
		/* TSP_INT on gpn0-0 (direct-to-GIC EINT), active low */
		interrupts-extended = <&gpn0 0 IRQ_TYPE_LEVEL_LOW>;
		/* TSP_RESET on gpp1-1 (peric0), asserted low */
		reset-gpios = <&gpp1 1 GPIO_ACTIVE_LOW>;
		/* vdd = L25M_TSP_DVDD (1.8V), avdd = L4M_TS_AVDD (3.3V) */
		vdd-supply = <&m_ldo25_reg>;
		avdd-supply = <&m_ldo4_reg>;

		/*
		 * Opt in to the Touch Bus Negotiator: with the display off the
		 * driver puts the IC into low-power gesture mode and hands the
		 * SPI bus to the AoC, so a tap can wake the AP without the AP
		 * being awake to see it.  Without this the driver takes the
		 * plain deep-sleep path and keeps the bus.
		 */
		goog,tbn-enabled;

		/* Native manual CS (mode 0) with a 2us setup delay, per vendor */
		controller-data {
			samsung,spi-feedback-delay = <0>;
			samsung,spi-chip-select-mode = <0>;
			cs-clock-delay = <2>;
		};
	};
};

&spi_21 {
	status = "okay";
};

&spi_22 {
	status = "okay";
};

&watchdog_cl0 {
	timeout-sec = <30>;
	status = "okay";
};

/*
 * The skin zone, on the thermistor next to the case rather than a sensor
 * inside the SoC. This is the one the vendor stack regulates on, and the
 * reason it can run the silicon hotter than a die-temperature policy dares
 * to: a die reading cannot tell a brief spike on a cold phone from sustained
 * load on a hot one, so it has to assume the worst and throttle early.
 *
 * The die zones in zumapro.dtsi stay as they are. They protect the silicon,
 * locally and quickly; this protects the user, globally and slowly. Where
 * both name the same cooling device the thermal core takes the higher
 * requested state, so the stricter of the two wins.
 *
 * Unlike those zones, this one budgets all four cooling devices together,
 * which is what a skin measurement actually constrains -- total board power,
 * however it is being spent.
 */
&{/thermal-zones} {
	skin-thermal {
		/* Skin temperature moves in seconds, not milliseconds. */
		polling-delay = <1000>;
		polling-delay-passive = <250>;
		thermal-sensors = <&s2mpg15_meter 1>;	/* quiet_therm */

		/*
		 * Both numbers below are the tuning knobs, and neither came
		 * from the vendor: its kernel delegates this zone to userspace
		 * ("user_space" governor, polling disabled) and the real
		 * control points live in the Android thermal HAL's config, not
		 * in its device tree. What its DT does say is where it gives
		 * up -- 56 C notify, 60 C shutdown, 65 C hardware shutdown --
		 * so the safe operating range sits well below those.
		 *
		 * The switch-on has to sit above the temperature the phone
		 * actually idles at, or the reset never fires and the integral
		 * can stay latched -- see the trips below. This board idles at
		 * 41-42 C skin with a compositor running, measured, so 43 C is
		 * the floor for it, and the control point has to be far enough
		 * above that for the derived gains to stay sane: a 45 C target
		 * would leave a 2 C band and a near-relay k_po of 1280.
		 *
		 * 50 C is therefore a consequence of this board idling warm,
		 * not a judgement that 50 C is a pleasant thing to hold. It
		 * sits under the vendor's own 56 C notify point. The honest fix
		 * is the idle temperature itself -- a phone with nothing to do
		 * should be nearer 33 C than 42 C -- and that is a separate
		 * problem: the panel runs at 120 Hz regardless, the GPU keeps
		 * its clocks up, and there is no cluster or system idle state.
		 * Lower this once those land.
		 */
		sustainable-power = <2500>;

		trips {
			/*
			 * The lower of two passive trips is IPA's switch-on
			 * point, and it is not optional. Below it the governor
			 * calls reset_pid_controller() and allow_maximum_power()
			 * and gets out of the way; with a single passive trip
			 * get_governor_trips() leaves trip_switch_on NULL, that
			 * branch never runs, and the governor controls at every
			 * temperature.
			 *
			 * That is how this zone first shipped, and the failure
			 * is worse than permanent mild control: integral_cutoff
			 * defaults to 0, so the integral term accumulates only
			 * while err < 0 -- above the control temperature. Once a
			 * warm spell winds it negative nothing unwinds it, the
			 * power budget stays clamped to zero, and every actor
			 * sits at its maximum cooling state for good. Measured:
			 * cpu0 pinned to 820 MHz, cpu4 to 357, cpu7 to 700 and
			 * the GPU to its floor, at 42 C against a 45 C
			 * set point, until the zone was disabled.
			 *
			 * The die zones in zumapro.dtsi have the same shape and
			 * the same latent problem; they get away with it only by
			 * sitting ~20 C below their set point, where the
			 * proportional term swamps the integral.
			 *
			 * No cooling map here: IPA allocates across the
			 * instances bound to the control trip below.
			 */
			skin_switch_on: switch-on {
				temperature = <43000>;
				hysteresis = <2000>;
				type = "passive";
			};

			skin_alert: throttle {
				temperature = <50000>;
				hysteresis = <2000>;
				type = "passive";
			};

			/* Mirrors the vendor's backup-shutdown-sw. */
			skin_crit: critical {
				temperature = <60000>;
				hysteresis = <2000>;
				type = "critical";
			};
		};

		cooling-maps {
			map0 {
				trip = <&skin_alert>;
				cooling-device = <&cpu0 THERMAL_NO_LIMIT
						  THERMAL_NO_LIMIT>;
			};

			map1 {
				trip = <&skin_alert>;
				cooling-device = <&cpu4 THERMAL_NO_LIMIT
						  THERMAL_NO_LIMIT>;
			};

			map2 {
				trip = <&skin_alert>;
				cooling-device = <&cpu7 THERMAL_NO_LIMIT
						  THERMAL_NO_LIMIT>;
			};

			map3 {
				trip = <&skin_alert>;
				cooling-device = <&gpu THERMAL_NO_LIMIT
						  THERMAL_NO_LIMIT>;
			};
		};
	};
};
