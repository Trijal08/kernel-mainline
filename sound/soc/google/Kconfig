menu "Google"

config SND_SOC_CHV3_I2S
	tristate "Google Chameleon v3 I2S device"
	help
	  Enable support for the Google Chameleon v3 I2S device.

config SND_SOC_GOOGLE_AOC
	tristate "Google AOC coprocessor audio"
	depends on GOOGLE_AOC
	help
	  ASoC platform and card for the Google AOC (Always-On Compute)
	  coprocessor found on Tensor SoCs.  The AOC does the audio DSP and
	  drives the amplifiers; this streams PCM to it over its audio IPC
	  rings.  Say M here if you have an AOC and want AOC-routed audio.

config SND_SOC_EXYNOS_DP_DMA
	tristate "Exynos DisplayPort audio DMA front end"
	depends on DRM_EXYNOS9_DP
	select SND_SOC_GENERIC_DMAENGINE_PCM
	help
	  CPU DAI that feeds the Exynos DisplayPort link's audio FIFO through a
	  PL330 channel. Pair it with the hdmi-codec the DP bridge registers
	  via simple-audio-card.

endmenu
